{
  "expo": {
    "name": "Fitlog",
    "slug": "fitlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitlog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.fitlog.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EE4B1A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fitlog.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0E0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fitlog gebruikt je foto’s zodat de coach je maaltijden kan herkennen.",
          "cameraPermission": "Fitlog gebruikt de camera om je maaltijd te fotograferen voor de coach.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
