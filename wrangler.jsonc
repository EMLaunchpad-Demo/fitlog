// Cloudflare Workers deploy for the Fitlog web app: static assets plus a small API
// (worker/index.js) for the encrypted backup and reminder notifications.
{
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "fitlogmartijn",
  "compatibility_date": "2026-11-09",
  "main": "worker/index.js",
  // Builds the web app into dist/ before every deploy.
  "build": {
    "command": "npx expo export --platform web"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // Serve index.html for app routes such as /coach (Expo Router is a single-page app).
    "not_found_handling": "single-page-application",
    // Only the API runs code; everything else is served as a static file.
    "run_worker_first": ["/api/*"]
  },
  // Storage for the encrypted backup, push subscriptions and the server's push keys.
  // KV namespace ids are not secret.
  "kv_namespaces": [{ "binding": "KV", "id": "5063bd1b19cf4d1e90e7d31fe7eac383" }],
  // Every five minutes: send the reminders that are due.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Preview deployments of branches get no storage and no cron, so they never touch real data;
  // the API answers "unavailable" there.
  "previews": {}
}
